# ---------------------------------------------------------------------------
# Prissy Plans Events — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# No local Postgres? Run `npm run db:local` and paste the URL it prints here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/prissyplans?schema=public"
# Connection pool size per server instance. Use 1 with `npm run db:local`; 5–10 for hosted Postgres.
DATABASE_POOL_MAX="10"

# Secret used to seal admin sessions (nuxt-auth-utils). Generate with: openssl rand -base64 32
NUXT_APP_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public site URL (canonical URLs, sitemap, emails and Open Graph).
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary (uploads for portfolio, services, testimonials and enquiry inspiration images).
# Leave empty to disable uploads; the admin dashboard shows a configuration notice instead.
NUXT_CLOUDINARY_CLOUD_NAME=""
NUXT_CLOUDINARY_API_KEY=""
NUXT_CLOUDINARY_API_SECRET=""
NUXT_CLOUDINARY_FOLDER="prissy-plans"

# Email notifications (SMTP via nodemailer). Leave NUXT_SMTP_HOST empty to log emails to the console.
NUXT_SMTP_HOST=""
NUXT_SMTP_PORT="587"
NUXT_SMTP_SECURE="false"
NUXT_SMTP_USER=""
NUXT_SMTP_PASS=""
NUXT_MAIL_FROM="Prissy Plans Events <no-reply@example.com>"
# Inbox that receives new-enquiry notifications. [PLACEHOLDER: replace with the real business inbox]
NUXT_ADMIN_NOTIFICATION_EMAIL=""

# Salt for hashing client IP addresses stored with enquiries (abuse tracing without storing raw IPs).
NUXT_IP_HASH_SALT="change-me"

# Fallback WhatsApp number. The number saved in Admin → Settings → Contact takes priority.
# Digits only, international format without "+", e.g. 2547XXXXXXXX. [PLACEHOLDER]
NUXT_PUBLIC_WHATSAPP_NUMBER=""
